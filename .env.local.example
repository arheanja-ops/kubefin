# Copia este archivo a .env.local (gitignorado, nunca se commitea) y llena tus valores reales.
# GIT_*, GH_CONFIG_DIR y AWS_PROFILE ya vienen del .envrc — no los repitas aquí.

# Groq (LLM gratis, usado por el agente `kubefin ask` — Fase 3). Obtener en console.groq.com
# (gratis, sin tarjeta). Sin esta variable, `kubefin ask` falla con mensaje que explica cómo obtenerla.
GROQ_API_KEY=

# Opcional — modelo Groq (por defecto: llama-3.3-70b-versatile).
# GROQ_MODEL=llama-3.3-70b-versatile
