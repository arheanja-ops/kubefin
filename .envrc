# direnv environment — aísla este repo a la identidad personal de GitHub y al perfil AWS personal.
# kubefin vive fuera de personal-projects/, así que NO hereda ningún aislamiento: sin este archivo,
# `git`/`gh`/`aws` usarían por defecto la identidad de TRABAJO (jhenao-nex). Este .envrc lo evita.
#
# Este archivo SÍ se commitea — no contiene secretos, solo lógica de carga. Los secretos reales
# (GROQ_API_KEY) van en .env.local (gitignorado). Ejecuta `direnv allow` una vez tras editarlo.

# --- Identidad git personal (nunca commits con la cuenta de trabajo) ---
export GIT_AUTHOR_NAME="Jaime Henao"
export GIT_AUTHOR_EMAIL="jaimehenao8126@outlook.com"
export GIT_COMMITTER_NAME="Jaime Henao"
export GIT_COMMITTER_EMAIL="jaimehenao8126@outlook.com"

# --- gh CLI aislado: config local al repo, nunca usa la cuenta de trabajo ---
# El directorio .gh/ está gitignorado y es local a este checkout.
# La primera vez: `gh auth login` estando parado aquí (usa la cuenta personal jaimehenao8126).
export GH_CONFIG_DIR="${PWD}/.gh"

# --- AWS: perfil personal (para Fase 2, análisis de costos / CUR) ---
# Se limpian credenciales estáticas heredadas del shell padre para que AWS_PROFILE sea la
# única fuente de verdad dentro de este árbol.
export AWS_PROFILE=taxops-admin
unset AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN 2>/dev/null || true

# --- Kubernetes: por defecto apunta a minikube para desarrollo/pruebas locales (Fase 1) ---
# Sobreescribible: exporta KUBECONFIG o cambia de contexto con `kubectl config use-context`.
# kubefin usa el contexto actual de kubectl vía client-go.

# --- Secretos locales (GROQ_API_KEY, etc.) — nunca se commitean ---
if [ -f .env.local ]; then
  dotenv .env.local
fi
